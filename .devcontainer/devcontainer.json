{
   "name": "StarterCpp Dev",
   "build": {
      "dockerfile": "../Dockerfile"
   },
   "workspaceFolder": "/workspaces/StarterCpp",
   "customizations": {
      "vscode": {
         "extensions": [
            "ms-vscode.cpptools",
            "ms-vscode.cmake-tools",
            "github.copilot",
            "github.copilot-chat"
         ],
         "settings": {
            "cmake.configureSettings": {},
            "cmake.generator": "Ninja",
            "editor.tabSize": 3,
            "editor.insertSpaces": true
         }
      }
   }
}
